# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*
# bootstrap state는 예외적으로 버전 관리한다.
# state 버킷 자체를 만드는 코드라 원격 backend를 쓸 수 없고,
# 이 state 파일이 없으면 다른 팀원이 bootstrap을 이어받을 수 없다.
!terraform/bootstrap/terraform.tfstate

# 개인 테스트 환경 (개인 AWS 계정 검증용, 팀 배포 환경 아님)
terraform/envs/personal-test/

# archive_file data source가 apply/plan 시마다 생성하는 Lambda 배포 패키지.
# 소스(.py)만 버전관리하면 되고, 빌드 산출물인 zip은 매번 재생성되므로 커밋 대상 아님.
*.zip

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version
# control as they are data points which are potentially sensitive and subject
# to change depending on the environment.
*.tfvars
*.tfvars.json
# 예시 파일은 값이 비어 있으므로 커밋한다 (docs/naming_convention_V2.md 10절)
!*.tfvars.example

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# tfplan 파일은 state와 같은 위험군(민감정보가 마스킹 없이 원본 그대로 저장될 수 있음)이라
# 커밋 대상에서 제외한다. 2026-09-17: envs/develop/tfplan이 실수로 커밋/push된 걸 발견해
# 이 규칙을 실제로 활성화함 — 그 전까진 예시 주석만 있고 적용 안 되고 있었음.
*tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc

# 자격증명·개인 키·kubeconfig — docs/cloud-infra-git-convention.md 15절 최소 항목
.env
.env.*
*.pem
*.key
kubeconfig
credentials
