// Jenkinsfile (ai - 판매자 수요 분석 API)
//
// MoongCheap-AI 레포에 AI팀이 올려둔 초안(PR #36)에서 Build/Test 단계는 그대로 두고,
// backend/frontend Jenkinsfile과 동일한(버그 수정 반영된) 패턴으로
// "GitOps 레포 업데이트" 단계를 채워 완성한 파일입니다.
//
// NOTE: 이 저장소(MoongCheap-AI)에는 이미지가 4개 있습니다 —
//   Dockerfile.seller-analysis(이 파일이 담당) · Dockerfile.awarding ·
//   Dockerfile.a-labeling · Dockerfile.demand-clustering.
//   나머지 세 개는 파트별 Job 구성이 정해진 뒤 별도로 추가합니다
//   (준우님 답변: Job은 파트별로 분리, 같은 ECR 레포(moongcheap/ai) 안에서
//   이미지 태그로 구분). 그래서 태그 앞에 COMPONENT를 붙여서 다른 파트
//   이미지와 절대 안 겹치게 했습니다.

pipeline {
    agent none

    environment {
        SERVICE_NAME    = 'ai'
        COMPONENT       = 'seller-analysis'
        BUILD_LABEL     = 'python-builder'
        ECR_REPO        = 'moongcheap/ai'
        ECR_REGISTRY    = '840851421204.dkr.ecr.ap-northeast-2.amazonaws.com'
        GITOPS_REPO_URL = 'https://github.com/V-MoongCheap/MoongCheap-Cloud.git'
        DOCKERFILE_PATH = 'docker/Dockerfile.seller-analysis'
    }

    stages {
        stage('Build') {
            agent { kubernetes { label BUILD_LABEL } }
            steps {
                checkout scm
                script {
                    if (env.BRANCH_NAME == 'main') {
                        env.ENVIRONMENT = 'prod'
                        env.BASE_BRANCH = 'main'
                    } else if (env.BRANCH_NAME == 'develop') {
                        env.ENVIRONMENT = 'develop'
                        env.BASE_BRANCH = 'develop'
                    } else {
                        error "지원하지 않는 배포 브랜치입니다: ${env.BRANCH_NAME}"
                    }

                    env.GIT_SHORT_SHA = sh(script: 'git rev-parse --short=7 HEAD', returnStdout: true).trim()
                    // 태그 앞에 COMPONENT를 붙여서, 같은 ECR 레포를 공유할 다른 파트
                    // (awarding / a-labeling / demand-clustering) 이미지와 겹치지 않게 한다.
                    env.IMAGE_TAG = "${COMPONENT}-${env.ENVIRONMENT}-${env.GIT_SHORT_SHA}"

                    echo "Git Commit SHA: ${env.GIT_SHORT_SHA}"
                    echo "Image Tag: ${env.IMAGE_TAG}"
                }
                container('builder') {
                    // 이미지 런타임은 requirements-api.txt 만 쓴다.
                    // 테스트는 pandas·pytest 가 더 필요해 여기서만 설치한다.
                    sh '''
                        python -m pip install --no-cache-dir -r requirements-api.txt "pytest>=8,<9" "pandas>=2.2,<3"
                    '''
                }
                stash name: 'build-output', includes: '**', excludes: '.git/**'
            }
        }

        stage('Test') {
            agent { kubernetes { label BUILD_LABEL } }
            steps {
                unstash 'build-output'
                container('builder') {
                    sh '''
                        python -m pip install --no-cache-dir -r requirements-api.txt "pytest>=8,<9" "pandas>=2.2,<3"
                        python -m pytest tests/seller_analysis -q
                    '''
                }
            }
        }

        stage('Build & Push Image to ECR') {
            agent { kubernetes { label BUILD_LABEL } }
            steps {
                unstash 'build-output'
                container('kaniko') {
                    sh """
                        /kaniko/executor \
                          --context=`pwd` \
                          --dockerfile=`pwd`/${DOCKERFILE_PATH} \
                          --destination=${ECR_REGISTRY}/${ECR_REPO}:${IMAGE_TAG}
                    """
                }
            }
        }

        stage('Update GitOps Repo (Image Tag)') {
            agent { kubernetes { label 'node-builder' } }
            steps {
                container('builder') {
                    withCredentials([
                        usernamePassword(credentialsId: 'gitops-repo-push', usernameVariable: 'GIT_USER', passwordVariable: 'GIT_TOKEN')
                    ]) {
                        sh '''
                            set -e
                            REPO_HOST="${GITOPS_REPO_URL#https://}"
                            BRANCH_NAME="ci/update-${SERVICE_NAME}-${IMAGE_TAG}-${BUILD_NUMBER}"

                            git clone "https://${GIT_USER}:${GIT_TOKEN}@${REPO_HOST}" gitops-repo
                            cd gitops-repo

                            git fetch origin "$BASE_BRANCH"
                            git checkout -b "$BRANCH_NAME" "origin/$BASE_BRANCH"

                            OVERRIDE_FILE="gitops/values/overrides/${ENVIRONMENT}/${SERVICE_NAME}.yaml"

                            YQ_VERSION="v4.44.3"
                            curl -sL "https://github.com/mikefarah/yq/releases/download/${YQ_VERSION}/yq_linux_amd64" -o /usr/local/bin/yq
                            chmod +x /usr/local/bin/yq

                            yq -i ".image.tag = \"${IMAGE_TAG}\"" "$OVERRIDE_FILE"

                            # 이미 같은 태그라 실제로 바뀐 게 없으면 커밋할 게 없어서
                            # git commit이 실패(exit 1)한다. set -e 때문에 그대로 두면
                            # 파이프라인 전체가 실패로 떨어지므로, 여기서 먼저 확인하고
                            # 변경이 없으면 조용히 정상 종료한다.
                            if git diff --quiet -- "$OVERRIDE_FILE"; then
                                echo "이미지 태그가 이미 ${IMAGE_TAG}입니다. GitOps 업데이트가 필요 없습니다."
                                exit 0
                            fi

                            git config user.name "jenkins-ci"
                            git config user.email "jenkins-ci@moongcheap.local"
                            git add "$OVERRIDE_FILE"
                            git commit -m "ci(gitops): update ${SERVICE_NAME}(${COMPONENT}) image tag to ${IMAGE_TAG}"
                            git push origin "$BRANCH_NAME"

                            GITOPS_API_REPO="${REPO_HOST#github.com/}"
                            GITOPS_API_REPO="${GITOPS_API_REPO%.git}"
                            curl --fail-with-body -sS -X POST \
                              -H "Authorization: token ${GIT_TOKEN}" \
                              -H "Accept: application/vnd.github+json" \
                              "https://api.github.com/repos/${GITOPS_API_REPO}/pulls" \
                              -d "{\"title\":\"ci(gitops): update ${SERVICE_NAME}(${COMPONENT}) image tag to ${IMAGE_TAG}\",\"head\":\"${BRANCH_NAME}\",\"base\":\"${BASE_BRANCH}\"}"
                        '''
                    }
                }
            }
        }
    }

    post {
        success {
            node('node-builder') {
                discordSend description: "브랜치: ${env.BRANCH_NAME} / 환경: ${env.ENVIRONMENT} / 태그: ${env.IMAGE_TAG}",
                            footer: "ai(seller-analysis) CI 빌드 성공",
                            link: env.BUILD_URL,
                            result: currentBuild.currentResult,
                            title: "${env.JOB_NAME} #${env.BUILD_NUMBER}",
                            webhookURL: credentials('discord-webhook-ci')
            }
            echo "이미지 ${ECR_REPO}:${IMAGE_TAG} 빌드/푸시 완료. 이미지 태그가 바뀌었다면 GitOps PR도 생성됨 — PR Merge 후 ArgoCD Sync 진행."
        }
        failure {
            node('node-builder') {
                discordSend description: "브랜치: ${env.BRANCH_NAME}",
                            footer: "ai(seller-analysis) CI 빌드 실패",
                            link: env.BUILD_URL,
                            result: currentBuild.currentResult,
                            title: "${env.JOB_NAME} #${env.BUILD_NUMBER}",
                            webhookURL: credentials('discord-webhook-ci')
            }
            echo "파이프라인 실패 — Build/Test/Push/GitOps 커밋 중 어느 단계인지 로그 확인 필요."
        }
    }
}
