// Jenkinsfile.template
//
// 사용 방법: 이 파일을 frontend/backend/ai 각 애플리케이션 레포의 최상위에
// `Jenkinsfile`이라는 이름으로 복사해두고, 맨 위 CONFIG 블록의 값만
// 서비스에 맞게 바꿔서 사용하세요.

pipeline {
    agent none

    environment {
        SERVICE_NAME   = 'backend'
        BUILD_LABEL    = 'java-builder'
        ECR_REPO       = 'moongcheap/backend'
        ECR_REGISTRY   = '<AWS_ACCOUNT_ID>.dkr.ecr.ap-northeast-2.amazonaws.com'
        GITOPS_REPO_URL = 'https://github.com/V-MoongCheap/MoongCheap-Cloud.git'
        ENVIRONMENT    = 'develop'
        GIT_SHORT_SHA = "${env.GIT_COMMIT?.take(7)}"
        IMAGE_TAG     = "${ENVIRONMENT}-${GIT_SHORT_SHA}"
    }

    stages {
        stage('Build') {
            agent { kubernetes { label BUILD_LABEL } }
            steps {
                container('builder') {
                    sh 'echo "TODO: 실제 빌드 명령으로 교체"'
                }
                // 각 stage마다 agent{kubernetes{...}}를 새로 선언하고 있어서
                // 같은 label이어도 stage마다 새 Pod가 뜸 → 여기서 만든 빌드 결과물이
                // 다음 stage Pod에는 안 남아있음. stash로 잠깐 보관해뒀다가
                // Test/Build&Push 단계에서 unstash로 꺼내 씀.
                stash name: 'build-output', includes: '**', excludes: '.git/**'
            }
        }

        stage('Test') {
            agent { kubernetes { label BUILD_LABEL } }
            steps {
                unstash 'build-output'
                container('builder') {
                    sh 'echo "TODO: 실제 테스트 명령으로 교체"'
                }
            }
        }

        stage('Build & Push Image to ECR') {
            agent { kubernetes { label BUILD_LABEL } }
            steps {
                unstash 'build-output'
                container('kaniko') {
                    // docker build / docker push 대신 Kaniko 사용.
                    // 이 Pod 안에는 Docker 데몬이 없어서 docker 명령 자체가 없음.
                    // ECR 로그인도 따로 필요 없음 — jenkins-sa에 연결된 IRSA 권한을
                    // Kaniko가 AWS 자격증명 체인을 통해 자동으로 사용함
                    // (설계서 원칙: 장기 Access Key 미사용).
                    sh """
                      /kaniko/executor \
                        --context=`pwd` \
                        --dockerfile=`pwd`/Dockerfile \
                        --destination=${ECR_REGISTRY}/${ECR_REPO}:${IMAGE_TAG}
                    """
                }
            }
        }

        stage('Update GitOps Repo (Image Tag)') {
            agent { kubernetes { label 'node-builder' } }
            steps {
                container('builder') {
                    withCredentials([
                        usernamePassword(credentialsId: 'gitops-repo-push', usernameVariable: 'GIT_USER', passwordVariable: 'GIT_TOKEN')
                    ]) {
                        // 큰따옴표(""") 대신 작은따옴표(''')를 써서, GIT_USER/GIT_TOKEN 같은
                        // 시크릿 값이 Groovy 단계에서 미리 스크립트 텍스트에 박히지 않고
                        // 셸이 실행되는 시점에 환경변수로 채워지도록 함 (시크릿 노출 방지).
                        sh '''
                          set -e
                          REPO_HOST="${GITOPS_REPO_URL#https://}"
                          BRANCH_NAME="ci/update-${SERVICE_NAME}-${IMAGE_TAG}"

                          # develop은 Ruleset(protect-develop)으로 직접 Push가 막혀있어서
                          # 별도 작업 브랜치를 만들어 그 브랜치로 Push함.
                          git clone "https://${GIT_USER}:${GIT_TOKEN}@${REPO_HOST}" gitops-repo
                          cd gitops-repo
                          git checkout -b "$BRANCH_NAME"

                          OVERRIDE_FILE="gitops/values/overrides/${ENVIRONMENT}/${SERVICE_NAME}.yaml"

                          # node:20 이미지엔 yq가 없어서, 실행 시점에 고정 버전으로 직접 설치
                          YQ_VERSION="v4.44.3"
                          curl -sL "https://github.com/mikefarah/yq/releases/download/${YQ_VERSION}/yq_linux_amd64" -o /usr/local/bin/yq
                          chmod +x /usr/local/bin/yq

                          yq -i ".image.tag = \"${IMAGE_TAG}\"" "$OVERRIDE_FILE"

                          git config user.name "jenkins-ci"
                          git config user.email "jenkins-ci@moongcheap.local"
                          git add "$OVERRIDE_FILE"
                          git commit -m "ci(gitops): update ${SERVICE_NAME} image tag to ${IMAGE_TAG}"
                          git push origin "$BRANCH_NAME"

                          # develop으로 향하는 PR을 GitHub API로 자동 생성 (직접 병합이 아니라 PR만 만듦)
                          GITOPS_API_REPO="${REPO_HOST#github.com/}"
                          GITOPS_API_REPO="${GITOPS_API_REPO%.git}"
                          curl -s -X POST \
                            -H "Authorization: token ${GIT_TOKEN}" \
                            -H "Accept: application/vnd.github+json" \
                            "https://api.github.com/repos/${GITOPS_API_REPO}/pulls" \
                            -d "{\"title\":\"ci(gitops): update ${SERVICE_NAME} image tag to ${IMAGE_TAG}\",\"head\":\"${BRANCH_NAME}\",\"base\":\"develop\"}"
                        '''
                    }
                }
            }
        }
    }

    post {
        success {
            echo "이미지 ${ECR_REPO}:${IMAGE_TAG} 빌드/푸시 및 GitOps 커밋 완료. ArgoCD Sync 대기 중."
        }
        failure {
            echo "파이프라인 실패 — Build/Test/Push/GitOps 커밋 중 어느 단계인지 로그 확인 필요."
        }
    }
}
